# Backend configuration (all optional; sensible defaults are used).

# Where the SQLite DB and encryption key are stored.
DATA_DIR=./data

# CORS origin for the frontend dev server.
FRONTEND_ORIGIN=http://localhost:5173

# Default polling interval (in seconds) for monitored inboxes. This is only the
# initial default; you can change it anytime from the app's Settings page.
EMAIL_POLL_INTERVAL_SECONDS=900

# Optional: override the auto-generated encryption key (base64 urlsafe, 32 bytes).
# If unset, a key is generated and stored in DATA_DIR/secret.key on first run.