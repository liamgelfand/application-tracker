{
  "manifest_version": 3,
  "name": "Job Application Tracker - Capture",
  "version": "1.0.0",
  "description": "Capture the job listing on the current page into your Job Application Tracker in one click.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture job listing"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
